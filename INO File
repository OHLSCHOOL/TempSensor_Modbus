#include <SPI.h>
#include <Wire.h>
#include <ETH.h>
#include <WiFi.h>
#include <OneWire.h>
#include <DallasTemperature.h>
#include <ModbusIP_ESP8266.h> // Modbus TCP Library
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// --- HARDWARE CONFIGURATION ---
#define ONE_WIRE_BUS 15

// Waveshare ESP32-S3-ETH W5500 SPI Pin Configuration
#define ETH_MISO_PIN 12
#define ETH_MOSI_PIN 11
#define ETH_SCLK_PIN 13
#define ETH_CS_PIN   14
#define ETH_INT_PIN  10
#define ETH_RST_PIN  9

// SSD1306 OLED I2C Configuration
#define OLED_SDA 17
#define OLED_SCL 39
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// --- STATIC NETWORK INITIALIZATION ---
IPAddress local_IP(120, 28, 117, 19);
IPAddress gateway(0, 0, 0, 0);
IPAddress subnet(255, 255, 255, 0);
IPAddress primaryDNS(0, 0, 0, 0);
IPAddress secondaryDNS(0, 0, 0, 0);

// --- MODBUS REGISTER DEFINITIONS ---
#define REG_TEMP_SCALED  1 // Address 40002: Temp * 100 (Integer)
#define REG_TEMP_FLOAT_H 2 // Address 40003: Raw Float Upper 16-bits
#define REG_TEMP_FLOAT_L 3 // Address 40004: Raw Float Lower 16-bits
#define MODBUS_UNIT_ID   1 // <-- Set the exact Slave/Unit ID your BMS expects

// --- OBJECT CORES ---
OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);
ModbusIP mb; // Create Modbus IP Instance (listens on default port 502)

bool eth_connected = false;
unsigned long lastMsgTime = 0;
const long interval = 2000; // Update temperature registers every 2 seconds

// --- OLED CYCLE CONFIGURATION ---
unsigned long lastScreenTime = 0;
const long screenInterval = 4000; // Cycle screens every 4 seconds
uint8_t currentScreen = 0;        // 0 = Status, 1 = IP, 2 = Temperature

String displayIP = "120.28.117.19";
String displayTempC = "Wait...";
String displayTempF = "Wait...";

void WiFiEvent(WiFiEvent_t event) {
  switch (event) {
    case ARDUINO_EVENT_ETH_START:
      Serial.println("ETH Started");
      ETH.setHostname("esp32s3-modbus-node");
      break;
    case ARDUINO_EVENT_ETH_CONNECTED:
      Serial.println("ETH Cable Connected");
      break;
    case ARDUINO_EVENT_ETH_GOT_IP:
      Serial.print("ETH IPv4: ");
      Serial.println(ETH.localIP());
      eth_connected = true;
      updateOLEDDisplay();
      break;
    case ARDUINO_EVENT_ETH_DISCONNECTED:
      Serial.println("ETH Cable Disconnected");
      eth_connected = false;
      updateOLEDDisplay();
      break;
    default:
      break;
  }
}

void updateOLEDDisplay() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  
  // Static Header for all screens
  display.setCursor(0, 0);
  display.println("--- BMS MODBUS NODE ---");
  display.drawLine(0, 11, 128, 11, SSD1306_WHITE); // Visual separator line

  // Dynamic Content Area based on current screen
  switch (currentScreen) {
    case 0: // SCREEN 1: SYSTEM STATUS
      display.setCursor(0, 18);
      display.println("[ SYSTEM STATUS ]");
      display.setCursor(0, 36);
      if (eth_connected) {
        display.println("Network: Connected");
        display.println("Modbus TCP: Active");
      } else {
        display.println("Network: DISCONNECTED");
        display.println("Modbus TCP: Offline");
      }
      break;

    case 1: // SCREEN 2: NETWORK CONFIG
      display.setCursor(0, 18);
      display.println("[ NETWORK CONFIG ]");
      display.setCursor(0, 36);
      display.print("IP:  ");
      display.println(displayIP);
      display.print("Sub: 255.255.255.0");
      break;

    case 2: // SCREEN 3: SENSOR DATA
      display.setCursor(0, 18);
      display.println("[ TEMPERATURE DATA ]");
      display.setCursor(0, 36);
      display.print("Celsius:    ");
      display.println(displayTempC);
      display.print("Fahrenheit: ");
      display.println(displayTempF);
      break;
  }

  display.display();
}

void setup() {
  Serial.begin(115200);
  while (!Serial && millis() < 5000) {
    delay(10);
  }
  Serial.println("\n--- Initializing Modbus TCP Node ---");

  Wire.begin(OLED_SDA, OLED_SCL);
  if(!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("SSD1306 allocation failed");
    for(;;);
  }
  
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0,20);
  display.println("Booting Modbus...");
  display.display();

  // Completely disable Wi-Fi and Bluetooth
  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
  btStop();

  sensors.begin();
  WiFi.onEvent(WiFiEvent);

  SPI.begin(ETH_SCLK_PIN, ETH_MISO_PIN, ETH_MOSI_PIN);
  ETH.begin(ETH_PHY_W5500, -1, ETH_CS_PIN, ETH_INT_PIN, ETH_RST_PIN, SPI);

  if (!ETH.config(local_IP, gateway, subnet, primaryDNS, secondaryDNS)) {
    Serial.println("ERROR: Static IP Network Configuration Failed!");
  } else {
    Serial.println("Static IP Configuration Applied.");
  }

  // Initialize Modbus server and register map
  mb.server();
  mb.addHreg(REG_TEMP_SCALED);
  mb.addHreg(REG_TEMP_FLOAT_H);
  mb.addHreg(REG_TEMP_FLOAT_L);

  updateOLEDDisplay();
}

void loop() {
  // Always run the Modbus task frame handlers if network is alive
  if (eth_connected) {
    mb.task();
  }

  unsigned long now = millis();

  // Task 1: Update temperature data and registers every 2 seconds
  if (now - lastMsgTime >= interval) {
    lastMsgTime = now;

    sensors.requestTemperatures();
    float tempC = sensors.getTempCByIndex(0);

    if (tempC != DEVICE_DISCONNECTED_C) {
      // 1. Process Scaled Integer (Temp * 100)
      uint16_t scaledTemp = (uint16_t)(tempC * 100);
      mb.Hreg(REG_TEMP_SCALED, scaledTemp);

      // 2. Process Raw 32-bit Float split across two 16-bit registers
      uint32_t floatRaw;
      memcpy(&floatRaw, &tempC, sizeof(floatRaw));
      mb.Hreg(REG_TEMP_FLOAT_H, (uint16_t)(floatRaw >> 16));
      mb.Hreg(REG_TEMP_FLOAT_L, (uint16_t)(floatRaw & 0xFFFF));

      // Update independent strings for screen layout
      displayTempC = String(tempC, 2) + " C";
      displayTempF = String(DallasTemperature::toFahrenheit(tempC), 1) + " F";

      // Refresh layout safely
      updateOLEDDisplay();

      Serial.print("Modbus Regs Updated | Temp: ");
      Serial.print(tempC);
      Serial.print(" C | Scaled Val: ");
      Serial.println(scaledTemp);
    } else {
      Serial.println("ERROR: Could not read DS18B20 sensor.");
      displayTempC = "ERROR";
      displayTempF = "ERROR";
      updateOLEDDisplay();
      
      mb.Hreg(REG_TEMP_SCALED, 0x9999);
    }
  }

  // Task 2: Cycle screen views independent of sensor readings every 4 seconds
  if (now - lastScreenTime >= screenInterval) {
    lastScreenTime = now;
    
    currentScreen = (currentScreen + 1) % 3; // Advance to next screen (0, 1, 2)
    updateOLEDDisplay();
  }
}

